<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_h"
    android:paddingTop="@dimen/margin_v"
    android:paddingEnd="@dimen/margin_h"
    android:paddingBottom="@dimen/margin_v">

    <include layout="@layout/view_screen_head" />

    <ar.vale.projectorlauncher.ui.SweepLine
        android:id="@+id/claude_sweep"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:visibility="invisible" />

    <ScrollView
        android:id="@+id/claude_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/claude_question"
                style="@style/Gd.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2" />

            <LinearLayout
                android:id="@+id/claude_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/claude_answer"
                style="@style/Gd.Display.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingMultiplier="1.12" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/claude_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/claude_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
