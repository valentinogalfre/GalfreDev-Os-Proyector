<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_h"
    android:paddingTop="@dimen/margin_v"
    android:paddingEnd="@dimen/margin_h"
    android:paddingBottom="@dimen/margin_v">

    <include layout="@layout/view_screen_head" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/juntada_side"
            android:layout_width="208dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="40dp"
            android:orientation="vertical">

            <ar.vale.projectorlauncher.remote.QrView
                android:id="@+id/juntada_qr"
                android:layout_width="208dp"
                android:layout_height="208dp" />

            <TextView
                android:id="@+id/juntada_lead"
                style="@style/Gd.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/juntada_names"
                style="@style/Gd.Data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/juntada_label"
                style="@style/Gd.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/juntada_title"
                style="@style/Gd.Display.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="4" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="14dp">

                <ar.vale.projectorlauncher.ui.LineProgress
                    android:id="@+id/juntada_time"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ar.vale.projectorlauncher.ui.SweepLine
                    android:id="@+id/juntada_sweep"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/juntada_lines"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/juntada_note"
                style="@style/Gd.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/juntada_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
