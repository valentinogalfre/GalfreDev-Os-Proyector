<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Resplandor animado de marca detrás del encabezado -->
    <View
        android:id="@+id/glow"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="-150dp"
        android:background="@drawable/glow_radial"
        android:alpha="0.5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad"
        android:paddingEnd="@dimen/pad"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- ===== Encabezado ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/logo_badge">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="monospace"
                        android:text="@string/logo_mark"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/brand"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="@color/accent2"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:fontFamily="sans-serif-thin"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="@color/accent2"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Aviso: poné Galfré como inicio (se oculta si ya lo es) -->
        <TextView
            android:id="@+id/default_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/default_chip"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ===== App principal destacada ===== -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hero_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <requestFocus />

            <ImageView
                android:id="@+id/hero_icon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/on_accent"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/hero_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:maxLines="1"
                    android:textColor="@color/on_accent"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="@color/on_accent"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- ===== Módulos Galfré ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_media" android:contentDescription="@string/module_media" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/module_media"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings_hub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_system" android:contentDescription="@string/module_settings_hub" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/module_settings_hub"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_apphub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_apps" android:contentDescription="@string/module_apphub" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/module_apphub"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_apk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_install" android:contentDescription="@string/module_apk" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/module_apk"
                    android:textColor="@color/text_primary" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Atajos rápidos ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="6">

            <LinearLayout
                android:id="@+id/q_wifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_wifi" android:contentDescription="@string/q_wifi" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/q_wifi"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q_bt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_bluetooth" android:contentDescription="@string/q_bt" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/q_bt"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_display" android:contentDescription="@string/q_display" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/q_display"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q_sound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_sound" android:contentDescription="@string/q_sound" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/q_sound"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/q_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_system" android:contentDescription="@string/q_all" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/q_all"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/quick_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_launcher_mark" android:contentDescription="@string/q_launcher" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/q_launcher"
                    android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Buscador ===== -->
        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/search_bg"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/apps_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- ===== Grilla de apps ===== -->
        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layoutAnimation="@anim/grid_anim"
            android:listSelector="@drawable/grid_selector"
            android:drawSelectorOnTop="true"
            android:clipToPadding="false"
            android:columnWidth="94dp"
            android:horizontalSpacing="12dp"
            android:numColumns="auto_fit"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:stretchMode="spacingWidthUniform"
            android:verticalSpacing="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Galfré Dev · v0.1.0"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
