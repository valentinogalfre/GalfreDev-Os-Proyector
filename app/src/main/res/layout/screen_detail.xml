<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_h"
    android:paddingTop="@dimen/margin_v"
    android:paddingEnd="@dimen/margin_h"
    android:paddingBottom="@dimen/margin_v">

    <include layout="@layout/view_screen_head" />

    <TextView
        android:id="@+id/detail_label"
        style="@style/Gd.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/detail_lead"
        style="@style/Gd.Display.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/detail_body"
        style="@style/Gd.Text"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/detail_caveat"
        style="@style/Gd.Text.Muted"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="15sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/detail_status"
        style="@style/Gd.Data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <ar.vale.projectorlauncher.ui.LineProgress
        android:id="@+id/detail_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="12dp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/detail_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
