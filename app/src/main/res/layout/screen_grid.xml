<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_h"
    android:paddingTop="@dimen/margin_v"
    android:paddingEnd="@dimen/margin_h">

    <include layout="@layout/view_screen_head" />

    <TextView
        android:id="@+id/search_row"
        style="@style/Gd.Text.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:maxLines="1"
        android:textSize="18sp" />

    <GridView
        android:id="@+id/screen_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:columnWidth="@dimen/tile_w"
        android:horizontalSpacing="11dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="6"
        android:paddingBottom="@dimen/margin_v"
        android:scrollbars="none"
        android:stretchMode="none"
        android:verticalSpacing="16dp" />
</LinearLayout>
