<?xml version="1.0" encoding="utf-8"?>
<!-- La cinta se apoya sobre el nombre: el arte de la app nunca queda debajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tile_w"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tile_art"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tile_h"
        android:background="@color/surface">

        <ImageView
            android:id="@+id/tile_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@id/tape_anchor"
        style="@style/Gd.Text.Medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp" />
</LinearLayout>
