<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Un launcher necesita ver el resto de apps para listarlas y abrirlas. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Estado de red (Wi-Fi/datos/IP) en el inicio y en el centro de ajustes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Tienda, Claude y la conexión con el celular. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Instalador de APKs (sideload). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Sin este permiso, el diálogo de desinstalar se cierra solo y sin avisar. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Explorador de archivos y reproductor: acceso a USB / memoria. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 11+: "acceso a todos los archivos", como cualquier gestor de archivos. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Celular: el servidor sigue andando mientras se usa otra app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Corre igual en un proyector con Android común o con Android TV, y sin pantalla táctil. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Apps de Android TV (Netflix/YouTube TV declaran solo esta categoría). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <!-- requestLegacyExternalStorage: en Android 10 permite listar el almacenamiento por
         ruta directa (explorador / modo APK). Android 11+ lo ignora y usa
         MANAGE_EXTERNAL_STORAGE. -->
    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Gd">

        <activity
            android:name=".LauncherActivity"
            android:theme="@style/Theme.Gd.Home"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Ícono en el menú de apps del proyector: permite abrirlo aunque el equipo
                 no muestre el diálogo para elegir pantalla de inicio. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Y en el menú de los equipos con Android TV. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".apps.AppsActivity" android:exported="false" />
        <activity android:name=".media.CineActivity" android:exported="false" />
        <activity android:name=".media.PlayerActivity" android:exported="false" />
        <activity android:name=".store.StoreActivity" android:exported="false" />
        <activity android:name=".store.StoreDetailActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".wall.WallActivity" android:exported="false" />
        <activity android:name=".remote.RemoteActivity" android:exported="false" />
        <activity android:name=".juntada.JuntadaActivity" android:exported="false" />
        <activity
            android:name=".carrera.CarreraActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="false"
            android:hardwareAccelerated="true" />
        <activity
            android:name=".claude.ClaudeActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity android:name=".device.CalibrationActivity" android:exported="false" />
        <activity android:name=".device.BlackoutActivity" android:exported="false" />

        <!-- Sirve .apk al instalador del sistema por content:// (solo lectura, no exportado). -->
        <provider
            android:name=".ApkProvider"
            android:authorities="ar.vale.projectorlauncher.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Le presta un video a otro reproductor cuando el del sistema no puede. -->
        <provider
            android:name=".media.MediaProvider"
            android:authorities="ar.vale.projectorlauncher.media"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".remote.RemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Control remoto del proyector desde el celular en la red local" />
        </service>

        <!-- Opcional: permite que el celular maneje también las otras apps. -->
        <service
            android:name=".remote.RemoteAccessibility"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_accessibility" />
        </service>

        <!-- La pared también como protector de pantalla del sistema. -->
        <service
            android:name=".wall.WallDream"
            android:exported="true"
            android:label="@string/word_pared"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Temporizador de apagado. El administrador solo pide bloquear la pantalla. -->
        <receiver android:name=".device.SleepReceiver" android:exported="false" />
        <receiver
            android:name=".device.SleepAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
